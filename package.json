{
  "name": "resolve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:ai:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.ai-live.config.ts",
    "test:workflow:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.workflow-live.config.ts",
    "test:full:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.full-live.config.ts",
    "test:quality:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.quality-live.config.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-database-types.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "node --env-file=.env.local scripts/run-live-e2e.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
