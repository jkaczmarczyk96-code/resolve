# Public project URL and publishable key; safe in the browser. No service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-local-or-hosted-publishable-key
SITE_URL=http://127.0.0.1:3000

# Phase 4 server-only AI configuration. Never prefix these keys with NEXT_PUBLIC_.
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional real search provider for the Researcher agent.
# TAVILY_API_KEY=

# Server-only scheduled monitoring credentials. Never expose in NEXT_PUBLIC_ variables.
# SUPABASE_SECRET_KEY=
# CRON_SECRET=

# Enable only after Google is configured in Supabase.
# AUTH_GOOGLE_ENABLED=false

# Phase 13 read-only Google Calendar and Gmail integration. Generate a random
# 32-byte base64url encryption key; never expose these values to the browser.
# GOOGLE_INTEGRATIONS_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# INTEGRATION_ENCRYPTION_KEY=
